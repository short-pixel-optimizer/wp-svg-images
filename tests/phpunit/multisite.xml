<?xml version="1.0"?>
<!-- Suite `multisite`: real WordPress installed as a network, with the plugin network-activated. Run through bin/test.sh. -->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="../bootstrap/multisite.php"
	cacheResult="false"
	colors="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<php>
		<const name="WP_TESTS_MULTISITE" value="1"/>
	</php>
	<testsuites>
		<testsuite name="multisite">
			<directory suffix="Test.php">../multisite</directory>
		</testsuite>
	</testsuites>
</phpunit>
